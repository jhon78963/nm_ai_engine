# Application
APP_NAME=Novedades Maritex AI
ENVIRONMENT=local

# Database — misma instancia que nm-backend (Laravel usa pgsql por defecto)
DATABASE_URL=postgresql+psycopg2://username:password@127.0.0.1:5432/nm_database

# Security — clave que nm-backend enviará en el header X-API-Key
API_KEY=nm-ai-dev-key-change-in-production
